---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";

// ── LISTENING ROOM CONFIG ────────────────────────────────────────────────────
// PASSWORD: distribute this to early access listeners.
const PASSWORD = "EMPIRE"; // ← change to your access code

// TRACKS: add SoundCloud track URLs (private links work).
// Use the track/playlist URL from SoundCloud, e.g.:
//   "https://soundcloud.com/empireeyes/your-track"
//   "https://soundcloud.com/empireeyes/sets/your-playlist"
const tracks: { title: string; label: string; year: number; scUrl: string }[] = [
  // {
  //   title: "Track Name",
  //   label: "Unreleased",
  //   year: 2026,
  //   scUrl: "https://soundcloud.com/empireeyes/your-track",
  // },
];
// ────────────────────────────────────────────────────────────────────────────
---

<Layout
  title="The Listening Room — Empire Eyes"
  description="Private early access listening. Empire Eyes."
>
  <!-- Gate -->
  <div class="lr-gate" id="lr-gate">
    <div class="lr-gate-inner">
      <p class="lr-gate-brand">EMPIRE EYES</p>
      <h1 class="lr-gate-title">THE LISTENING ROOM</h1>
      <p class="lr-gate-hint">Access code required</p>
      <form class="lr-gate-form" id="lr-gate-form" autocomplete="off">
        <input
          type="password"
          id="lr-gate-input"
          class="lr-gate-input"
          placeholder="· · · · · ·"
          autocomplete="off"
          spellcheck="false"
          aria-label="Access code"
        />
        <button type="submit" class="lr-gate-submit">ENTER</button>
      </form>
      <p class="lr-gate-error" id="lr-gate-error" aria-live="polite"></p>
    </div>
  </div>

  <!-- Room -->
  <main class="lr-room" id="lr-room" aria-hidden="true">
    <header class="lr-room-header content">
      <p class="lr-room-brand">EMPIRE EYES</p>
      <h1 class="lr-room-title">THE LISTENING ROOM</h1>
      <p class="lr-room-sub">Early access &middot; Private</p>
    </header>

    <div class="lr-tracks content">
      <!-- Disco Volante -->
      <div class="lr-track">
        <div class="lr-track-meta">
          <span class="lr-track-title">Disco Volante</span>
          <span class="lr-track-label">Playlist &middot; 2026</span>
        </div>
        <div class="lr-embed">
          <iframe
            width="100%"
            height="300"
            scrolling="no"
            frameborder="no"
            allow="autoplay; encrypted-media"
            loading="lazy"
            src="https://w.soundcloud.com/player/?url=https%3A//api.soundcloud.com/playlists/soundcloud%3Aplaylists%3A2292403677%3Fsecret_token%3Ds-N2Gsxw8PCGv&color=%23c8c8c8&auto_play=true&hide_related=false&show_comments=true&show_user=true&show_reposts=false&show_teaser=true&visual=true"
          />
        </div>
      </div>

      {tracks.map((t) => (
        <div class="lr-track">
          <div class="lr-track-meta">
            <span class="lr-track-title">{t.title}</span>
            <span class="lr-track-label">{t.label} &middot; {t.year}</span>
          </div>
          <div class="lr-embed">
            <iframe
              width="100%"
              height="120"
              scrolling="no"
              frameborder="no"
              allow="autoplay"
              loading="lazy"
              src={`https://w.soundcloud.com/player/?url=${encodeURIComponent(t.scUrl)}&color=%23000000&inverse=true&auto_play=false&show_user=false&hide_related=true&show_comments=false&show_reposts=false&show_teaser=false`}
            />
          </div>
        </div>
      ))}
    </div>

    <footer class="lr-footer content">
      <p class="lr-footer-text">What you hear here doesn't leave this room.</p>
    </footer>
  </main>

  <script define:vars={{ PASSWORD }}>
    const KEY = "ee-room-v1";
    const gate = document.getElementById("lr-gate");
    const room = document.getElementById("lr-room");
    const form = document.getElementById("lr-gate-form");
    const input = document.getElementById("lr-gate-input");
    const errorEl = document.getElementById("lr-gate-error");

    function unlock() {
      sessionStorage.setItem(KEY, "1");
      gate.classList.add("lr-gate--out");
      room.classList.add("lr-room--visible");
      room.removeAttribute("aria-hidden");
      setTimeout(() => gate.remove(), 700);
    }

    if (sessionStorage.getItem(KEY) === "1") {
      unlock();
    } else {
      // Ensure gate is visible (handles any flash-of-room on slow paint)
      gate.style.display = "flex";
      setTimeout(() => input && input.focus(), 50);
    }

    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const val = input.value.trim();
      if (val.toUpperCase() === PASSWORD.toUpperCase()) {
        errorEl.textContent = "";
        unlock();
      } else {
        errorEl.textContent = "Incorrect.";
        input.value = "";
        input.focus();
        input.classList.add("lr-gate-input--shake");
        setTimeout(() => input.classList.remove("lr-gate-input--shake"), 500);
      }
    });
  </script>
</Layout>

<style is:global>
  /* ── GATE ─────────────────────────────────────────────────── */
  .lr-gate {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: var(--bg);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: var(--gutter);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  .lr-gate--out {
    opacity: 0;
    pointer-events: none;
  }

  .lr-gate-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    max-width: 320px;
    width: 100%;
  }

  .lr-gate-brand {
    font-family: var(--font-display);
    font-size: 0.72rem;
    letter-spacing: 0.38em;
    color: var(--dim);
  }

  .lr-gate-title {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 5vw, 1.8rem);
    letter-spacing: 0.18em;
    line-height: 1.1;
  }

  .lr-gate-hint {
    font-size: 0.7rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .lr-gate-form {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
  }

  .lr-gate-input {
    width: 100%;
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--border);
    color: var(--fg);
    font-family: var(--font-body);
    font-size: 1rem;
    letter-spacing: 0.35em;
    text-align: center;
    padding: 0.75rem 0;
    outline: none;
    transition: border-color 0.15s;
    caret-color: var(--fg);
  }

  .lr-gate-input:focus {
    border-color: var(--dim);
  }

  .lr-gate-input::placeholder {
    color: #333;
    letter-spacing: 0.5em;
  }

  @keyframes lr-shake {
    0%, 100% { transform: translateX(0); }
    20%       { transform: translateX(-6px); }
    40%       { transform: translateX(6px); }
    60%       { transform: translateX(-4px); }
    80%       { transform: translateX(4px); }
  }

  .lr-gate-input--shake {
    animation: lr-shake 0.45s ease;
    border-color: #555;
  }

  .lr-gate-submit {
    background: transparent;
    border: 1px solid var(--border);
    color: var(--dim);
    font-family: var(--font-body);
    font-size: 0.68rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    padding: 0.65rem 2rem;
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
  }

  .lr-gate-submit:hover {
    border-color: var(--fg);
    color: var(--fg);
  }

  .lr-gate-error {
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--dim);
    min-height: 1em;
  }

  /* ── ROOM ─────────────────────────────────────────────────── */
  .lr-room {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.7s ease 0.1s;
  }

  .lr-room--visible {
    opacity: 1;
    pointer-events: auto;
  }

  .lr-room-header {
    padding-top: 4rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
    border-top: none;
  }

  .lr-room-brand {
    font-family: var(--font-display);
    font-size: 0.65rem;
    letter-spacing: 0.4em;
    color: var(--dim);
    margin-bottom: 0.75rem;
  }

  .lr-room-title {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 5vw, 2rem);
    letter-spacing: 0.14em;
    line-height: 1.1;
    margin-bottom: 0.6rem;
  }

  .lr-room-sub {
    font-size: 0.68rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--dim);
  }

  /* ── TRACKS ───────────────────────────────────────────────── */
  .lr-tracks {
    padding-top: 2rem;
    padding-bottom: 1rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    border-left: 1px solid var(--border);
    border-right: 1px solid var(--border);
  }

  .lr-empty {
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    color: var(--dim);
    text-transform: uppercase;
    padding: 2rem 0;
  }

  .lr-track {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }

  .lr-track:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .lr-track-meta {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .lr-track-title {
    font-family: var(--font-display);
    font-size: 1rem;
    letter-spacing: 0.1em;
  }

  .lr-track-label {
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .lr-embed {
    border: 1px solid var(--border);
    overflow: hidden;
    background: #050505;
  }

  .lr-embed iframe {
    display: block;
  }

  /* ── FOOTER ───────────────────────────────────────────────── */
  .lr-footer {
    padding: 2rem 0 3rem;
    border-top: 1px solid var(--border);
    text-align: center;
    border-left: 1px solid var(--border);
    border-right: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .lr-footer-text {
    font-size: 0.62rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #444;
    font-style: italic;
  }
</style>
