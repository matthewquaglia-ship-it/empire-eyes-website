---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
---

<Layout
  title="Disco Volante — Empire Eyes"
  description="Disco Volante release magazine by Empire Eyes."
>
  <main class="mag-main">
    <div class="mag-nav">
      <a href="/#release">&larr; EMPIRE EYES</a>
      <a href="/press/disco-volante-magazine.pdf" download class="mag-download">DOWNLOAD &darr;</a>
    </div>
    <div class="mag-viewer">
      <iframe
        src="/press/disco-volante-magazine.pdf#zoom=page-fit"
        class="mag-frame"
        title="Disco Volante — Release Magazine"
      ></iframe>
    </div>
  </main>
</Layout>

<style>
  .mag-main {
    display: flex;
    flex-direction: column;
    height: 100vh;
    overflow: hidden;
  }

  .mag-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem var(--gutter, 1.25rem);
    border-bottom: 1px solid var(--border);
    flex-shrink: 0;
  }

  .mag-nav a {
    font-size: 0.65rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--dim);
    transition: color 0.15s;
  }
  .mag-nav a:hover { color: var(--fg); }

  .mag-viewer {
    flex: 1;
    overflow: hidden;
  }

  .mag-frame {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
  }
</style>
