---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
---

<Layout
  title="Disco Volante Magazine — Empire Eyes"
  description="Disco Volante release magazine by Empire Eyes."
>
  <div class="mag-wrap">
    <nav class="mag-nav">
      <a href="/#release">&larr; EMPIRE EYES</a>
      <span class="mag-info" id="mag-info"></span>
      <a href="/press/disco-volante-magazine.pdf" download>DOWNLOAD &darr;</a>
    </nav>
    <div class="mag-pages" id="mag-pages">
      <p class="mag-loading" id="mag-loading">Loading…</p>
    </div>
  </div>
</Layout>

<script is:inline>
(async function () {
  const CDN  = "https://cdn.jsdelivr.net/npm/pdfjs-dist@2.16.105/build/pdf.min.js";
  const WRKR = "https://cdn.jsdelivr.net/npm/pdfjs-dist@2.16.105/build/pdf.worker.min.js";

  await new Promise(function (resolve, reject) {
    var s = document.createElement("script");
    s.src = CDN;
    s.onload = resolve;
    s.onerror = reject;
    document.head.appendChild(s);
  });

  var lib     = window["pdfjsLib"];
  lib.GlobalWorkerOptions.workerSrc = WRKR;

  var pages   = document.getElementById("mag-pages");
  var info    = document.getElementById("mag-info");
  var loading = document.getElementById("mag-loading");

  try {
    var pdf = await lib.getDocument("/press/disco-volante-magazine.pdf").promise;
    info.textContent = pdf.numPages + " pages";
    loading.remove();

    var dpr = Math.min(window.devicePixelRatio || 1, 2);

    for (var n = 1; n <= pdf.numPages; n++) {
      var page   = await pdf.getPage(n);
      var baseVP = page.getViewport({ scale: 1 });
      var scale  = Math.min(2, (window.innerWidth - 32) / baseVP.width);
      var vp     = page.getViewport({ scale: scale * dpr });
      var canvas = document.createElement("canvas");
      canvas.width  = vp.width;
      canvas.height = vp.height;
      canvas.style.width  = Math.round(vp.width  / dpr) + "px";
      canvas.style.height = Math.round(vp.height / dpr) + "px";
      pages.appendChild(canvas);
      await page.render({ canvasContext: canvas.getContext("2d"), viewport: vp }).promise;
    }
  } catch (err) {
    if (loading) loading.textContent = "Could not load PDF.";
    console.error(err);
  }
})();
</script>

<style>
  .mag-wrap {
    min-height: 100vh;
  }

  .mag-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem var(--gutter, 1.25rem);
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    background: var(--bg);
    z-index: 10;
  }

  .mag-nav a,
  .mag-info {
    font-size: 0.65rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--dim);
    transition: color 0.15s;
  }
  .mag-nav a:hover { color: var(--fg); }

  .mag-pages {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    padding: 2rem 0;
  }

  .mag-pages canvas {
    display: block;
    max-width: 100%;
    height: auto;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.7);
  }

  .mag-loading {
    font-size: 0.65rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--dim);
    padding: 4rem 0;
  }
</style>
