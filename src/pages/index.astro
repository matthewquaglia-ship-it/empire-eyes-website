---
import Layout from "../layouts/Layout.astro";
import SatelliteTV from "../components/SatelliteTV.astro";
import "../styles/global.css";
import { artistLinks, socialLinks, releases, artist, videos } from "../data/links";

const slugify = (title: string) => title.toLowerCase().replace(/\s+/g, "-");

// Hero always shows the most recent release — just append to the releases array
const latestRelease = releases[releases.length - 1];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "MusicGroup",
  name: "Empire Eyes",
  description: "Empire Eyes delves deep into the enigmatic and complex nature of existence, weaving poetic lyrics with emotive melodies to create a sonic landscape that is at once mesmerising and thought-provoking. Alternative / Future Pop.",
  genre: ["Alternative", "Future Pop"],
  image: "https://www.empire-eyes.com/images/og-image.jpg",
  url: "https://www.empire-eyes.com",
  sameAs: [
    "https://open.spotify.com/artist/6fvpctR3TvJWAnRI0Q8wWe",
    "https://music.apple.com/us/artist/empire-eyes/1672824701",
    "https://www.instagram.com/empire.eyes/",
    "https://www.youtube.com/@empireeyes",
    "https://www.tiktok.com/@empire.eyes.official",
    "https://empireeyes.bandcamp.com/",
    "https://soundcloud.com/empireeyes",
    "https://listen.tidal.com/artist/37490305",
    "https://link.deezer.com/s/32X2QWbJZKyGa8RAUaydg",
    "https://www.facebook.com/empireeyesmusic",
    "https://empireeyesmusic.substack.com",
  ],
  album: releases.map((r) => ({
    "@type": "MusicAlbum",
    name: r.title,
    ...(r.datePublished ? { datePublished: r.datePublished } : {}),
    ...("tracks" in r ? { numTracks: r.tracks } : {}),
  })),
};
---

<Layout>
  <script slot="structured-data" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <!-- Hero: full-viewport, typographic -->
  <section class="hero">
    <div class="hero-bg"></div>
    <div class="hero-content">
      <h1 class="hero-title" data-text="EMPIRE EYES">EMPIRE EYES</h1>
    </div>
    <span class="hero-scroll">&#x2193;</span>
  </section>

  <!-- Column Content -->
  <main class="content">

    <!-- Satellite TV: VHS-filtered clips, sits above the bio -->
    <section class="section satellite-tv" id="tv" aria-label="Empire Eyes Worldwide TV">
      <SatelliteTV />
    </section>

    <!-- Bio -->
    <section class="section" id="about">
      <h2 class="section-label">About</h2>
      <!-- Bio as a perspective text crawl. The text is real page text, so it stays readable for search engines and screen readers. -->
      <div class="crawl" tabindex="0" aria-label="About Empire Eyes. Hover or focus to pause.">
        <div class="crawl__stage">
          <div class="crawl__text">
            <p class="crawl__kicker">Empire Eyes</p>
            <p class="crawl__motto">Sell your soul to yourself;<br />don&rsquo;t leave anything behind&hellip;</p>
            <p>Empire Eyes delves deep into the enigmatic and complex nature of existence, unraveling its mysteries and presenting them in a unique and authentic way. With a sound that is both hauntingly beautiful and deeply moving, Empire Eyes weaves together poetic lyrics and emotive melodies to create a sonic landscape that is at once mesmerising and thought-provoking.</p>
            <p>Drawing inspiration from a wide range of musical genres and artistic influences, Empire Eyes has quickly established himself as an emerging presence in the alternative / future pop scene. With a fierce dedication to the craft and a deep passion for creating music that speaks to the soul, Empire Eyes is poised to make a lasting impact on the world of music and beyond.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Releases -->
    <section class="section" id="release">
      <h2 class="section-label">Releases</h2>
      <ul class="release-list">
        {
          [...releases].reverse().map((r) => {
            const streamId = `stream-${r.title.replace(/\s+/g, "-").toLowerCase()}`;
            const loreId = `lore-${r.title.replace(/\s+/g, "-").toLowerCase()}`;
            return (
              <li class="release-card">
                <input type="checkbox" id={streamId} class="release-toggle" />
                <input type="checkbox" id={loreId} class="lore-toggle" />
                <a href={`/releases/${slugify(r.title)}`} class="release-art-link">
                  <img
                    src={r.artwork}
                    alt={`${r.title} artwork`}
                    class="release-art"
                    width="80"
                    height="80"
                    loading="lazy"
                  />
                </a>
                <div class="release-info release-info--music">
                  <a href={`/releases/${slugify(r.title)}`} class="release-title-link">
                    <span class="release-title">{r.title}</span>
                  </a>
                  <span class="release-meta">
                    {r.type} &middot; {r.year}
                    {"tracks" in r ? ` · ${r.tracks} tracks` : ""}
                  </span>
                  <span class="release-meta">{r.genre}</span>
                  <div class="release-actions">
                    {"lore" in r && <label for={loreId} class="release-platforms-toggle">READ ↓</label>}
                    {"listenUrl" in r
                      ? <a href={r.listenUrl as string} class="release-platforms-toggle">PRE RELEASE LISTEN →</a>
                      : <label for={streamId} class="release-platforms-toggle">STREAM ↓</label>
                    }
                  </div>
                </div>
                {"lore" in r && (
                  <div class="release-lore">
                    {(r.lore as string).split("\n\n").map((para) => (
                      <p>{para}</p>
                    ))}
                  </div>
                )}
                {"listenUrl" in r ? null : (
                  <ul class="release-platform-list">
                    {r.platforms.map((p) => (
                      <li>
                        <a href={p.url} target="_blank" rel="noopener noreferrer">
                          <span>{p.name}</span>
                          <span class="link-arrow">&rarr;</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            );
          })
        }
      </ul>
    </section>

    <!-- Watch -->
    <section class="section" id="watch">
      <h2 class="section-label">Watch</h2>
      <ul class="release-list">
        {
          videos.map((video) => (
            <li class="release-card">
              <a
                href={`https://www.youtube.com/watch?v=${video.id}`}
                target="_blank"
                rel="noopener noreferrer"
                class="release-art-link video-thumb-link"
              >
                <img
                  src={`https://img.youtube.com/vi/${video.id}/mqdefault.jpg`}
                  alt={`${video.title} thumbnail`}
                  class="release-art video-thumb"
                  loading="lazy"
                />
              </a>
              <div class="release-info">
                <span class="release-title">{video.title}</span>
                <span class="release-meta">{video.label}</span>
                <span class="release-meta">{video.year}</span>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- Listen: links to artist profile on each streaming platform -->
    <section class="section" id="listen">
      <h2 class="section-label">Listen</h2>
      <ul class="link-list">
        {
          artistLinks.map((link) => (
            <li class="link-item">
              <a href={link.url} target="_blank" rel="noopener noreferrer">
                <span>{link.name}</span>
                <span class="link-arrow">&rarr;</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- Follow -->
    <section class="section" id="follow">
      <h2 class="section-label">Follow</h2>
      <ul class="link-list">
        {
          socialLinks.map((link) => (
            <li class="link-item">
              <a href={link.url} target="_blank" rel="noopener noreferrer">
                <span>{link.name}</span>
                <span class="link-arrow">&rarr;</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- Subscribe -->
    <section class="section" id="subscribe">
      <h2 class="section-label">Subscribe</h2>
      <a
        href={artist.subscribeUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="subscribe-link"
      >
        Get Updates
      </a>
    </section>

    <!-- Footer -->
    <footer class="footer">
      <p class="footer-text">
        &copy; {new Date().getFullYear()} {artist.name}
        <br />
        {artist.label}
      </p>
    </footer>

  </main>
  <script>
    // ── HOLD TO ENTER: hold the hero title for 1.5s to reach the Listening Room ──
    const title = document.querySelector('.hero-title') as HTMLElement | null;
    const HOLD_MS = 1500;
    let holdTimer: ReturnType<typeof setTimeout> | null = null;

    function startHold(e: Event) {
      e.preventDefault();
      if (!title) return;
      title.classList.add('hero-title--holding');
      holdTimer = setTimeout(() => {
        window.location.href = '/listening-room';
      }, HOLD_MS);
    }

    function cancelHold() {
      if (holdTimer) { clearTimeout(holdTimer); holdTimer = null; }
      title?.classList.remove('hero-title--holding');
    }

    title?.addEventListener('mousedown', startHold);
    title?.addEventListener('touchstart', startHold, { passive: false });
    document.addEventListener('mouseup', cancelHold);
    document.addEventListener('touchend', cancelHold);
    document.addEventListener('touchcancel', cancelHold);
    title?.addEventListener('contextmenu', e => e.preventDefault());
    title?.setAttribute('draggable', 'false');
  </script>
</Layout>
